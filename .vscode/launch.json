{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SCM: 웹 서버 실행 + 브라우저 열기",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${env:USERPROFILE}/AppData/Local/Programs/nodejs/node.exe",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": ["--host", "127.0.0.1", "--port", "5173", "--strictPort"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "outputCapture": "std",
      "env": {
        "NO_COLOR": "1",
        "FORCE_COLOR": "0"
      },
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "SCM: 실행 중인 서버 Edge 디버깅",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
